{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreDependencies": ["pptxgenjs", "prettier"],
	"ignoreBinaries": ["codex"],
	"ignoreFiles": ["packages/*/dist/**"],
	"ignoreIssues": { "vendor/braces/lib/utils.js": ["exports"] },
	"workspaces": {
		"packages/error-boundaries": {
			"entry": ["src/index.ts", "src/react.tsx", "src/astro.ts", "src/next.ts", "test/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"],
			"ignoreDependencies": ["@types/react-dom", "react-dom"]
		},
		"packages/reporting": {
			"entry": [
				"src/core.ts",
				"src/playwright.ts",
				"src/viewports.ts",
				"src/load-testing.ts",
				"src/spreadsheet.ts",
				"src/slideshow.ts",
				"src/metadata.ts",
				".agents/skills/review/weekly/scripts/generate-weekly-review.mjs",
				"test/*.test.mjs"
			],
			"project": ["src/**/*.ts", ".agents/skills/review/weekly/scripts/**/*.mjs", "test/**/*.mjs"],
			"ignoreDependencies": ["@oai/artifact-tool", "colorjs.io"]
		},
		"packages/testing": {
			"entry": ["src/index.mjs", "src/cli.mjs"],
			"project": ["src/**/*.mjs"]
		},
		"packages/quality": {
			"entry": [
				"src/index.ts",
				"src/runner.ts",
				"src/app/workspace-test-runner.ts",
				"src/naming.ts",
				"src/object-forwarding.ts",
				"src/single-use.ts",
				"src/port.ts",
				"src/history-report.ts",
				"test/**/*.test.mjs"
			],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"docs": {
			"entry": ["src/pages/**/*.astro", "astro.config.mjs", "scripts/*.mjs"],
			"project": ["src/**/*.astro", "src/**/*.tsx", "src/**/*.ts", "src/**/*.mdx", "scripts/**/*.mjs"],
			"ignoreDependencies": ["@terra-symposium/styling"]
		},
		"apps/hygiene": {
			"entry": ["src/pages/index.astro", "netlify/functions/*.mts", "scripts/*.ts", "test/*.test.ts"],
			"project": ["src/**/*.ts", "src/**/*.tsx", "netlify/functions/**/*.mts", "scripts/**/*.ts", "test/**/*.ts"]
		}
	}
}
