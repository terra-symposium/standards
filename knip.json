{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreDependencies": ["pptxgenjs", "prettier"],
	"ignoreFiles": ["packages/*/dist/**"],
	"workspaces": {
		"packages/error-boundaries": {
			"entry": ["src/index.ts", "src/react.tsx", "src/astro.ts", "src/next.ts", "test/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"],
			"ignoreDependencies": ["@types/react-dom", "react-dom"]
		},
		"packages/reporting": {
			"entry": ["src/core.ts", "src/playwright.ts", "src/viewports.ts", "src/load-testing.ts", "src/spreadsheet.ts", "src/slideshow.ts", "src/metadata.ts", "test/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/quality": {
			"entry": [
				"src/index.ts",
				"src/runner.ts",
				"src/workspace-test-runner.ts",
				"src/naming.ts",
				"src/object-forwarding.ts",
				"src/single-use.ts",
				"src/port.ts",
				"src/history-report.ts",
				"test/**/*.test.mjs"
			],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"apps/hygiene": {
			"entry": ["src/pages/index.astro", "netlify/functions/*.mts", "scripts/*.ts", "test/*.test.ts"],
			"project": ["src/**/*.ts", "src/**/*.tsx", "netlify/functions/**/*.mts", "scripts/**/*.ts", "test/**/*.ts"]
		}
	}
}
