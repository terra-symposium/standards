{
	"name": "@terra-symposium/reporting",
	"version": "0.1.0",
	"description": "Reusable Playwright evidence reporting for Terra repositories",
	"type": "module",
	"main": "./dist/core.js",
	"types": "./dist/core.d.ts",
	"engines": {
		"node": ">=18.18"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Terra-Symposium/terra-shared.git"
	},
	"exports": {
		".": "./dist/core.js",
		"./core": "./dist/core.js",
		"./playwright": "./dist/playwright.js",
		"./viewports": "./dist/viewports.js",
		"./spreadsheet": "./dist/spreadsheet.js",
		"./slideshow": "./dist/slideshow.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "node --test test/*.test.mjs"
	},
	"dependencies": {
		"exceljs": "^4.4.0",
		"jszip": "^3.10.2",
		"pptxgenjs": "^4.0.1",
		"sharp": "^0.35.3"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.52.0 <2"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@types/node": "^22.14.1",
		"typescript": "^5.9.3"
	}
}
