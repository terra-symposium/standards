{
	"name": "@terra-symposium/standards-quality",
	"version": "2.0.1",
	"description": "Configurable quality checks and maintenance tooling for Terra Symposium repositories",
	"homepage": "https://standards-docs.netlify.app/",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"terra-quality": "dist/runner.js"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Terra-Symposium/standards.git"
	},
	"exports": {
		".": "./dist/index.js",
		"./cli": "./dist/runner.js",
		"./naming": "./dist/naming.js",
		"./object-forwarding": "./dist/object-forwarding.js",
		"./single-use": "./dist/single-use.js",
		"./port": "./dist/port.js"
	},
	"files": [
		"dist",
		"quality.schema.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepare": "npm run build",
		"test": "node --test"
	},
	"dependencies": {
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5"
	}
}
