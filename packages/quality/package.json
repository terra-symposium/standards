{
	"name": "@terra-symposium/quality",
	"version": "2.4.3",
	"description": "Configurable quality checks and maintenance tooling for software repositories",
	"homepage": "https://standards-docs.netlify.app/",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"terra-quality": "dist/lib/runner.js",
		"terra-quality-dev": "dist/lib/dev.js",
		"terra-quality-reports": "dist/capabilities/reports/cli.js",
		"terra-ui-quality": "dist/capabilities/ui/cli.js",
		"terra-language-checks": "dist/capabilities/languages/cli.js",
		"terra-documentation": "dist/capabilities/documentation/cli.js",
		"terra-formatting": "dist/capabilities/formatting/cli.js",
		"terra-imports": "dist/capabilities/imports/cli.js",
		"terra-naming": "dist/capabilities/naming/cli.js",
		"terra-patterns": "dist/capabilities/patterns/cli.js",
		"terra-refactoring": "dist/capabilities/refactoring/cli.js",
		"terra-security": "dist/capabilities/security/cli.js"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Terra-Symposium/standards.git"
	},
	"exports": {
		".": "./dist/index.js",
		"./error-boundaries/react": "./dist/lib/error-boundaries-react.js",
		"./astro-integration": "./dist/lib/error-boundaries-astro.js",
		"./cli": "./dist/lib/runner.js",
		"./naming": {
			"types": "./dist/capabilities/naming/index.d.ts",
			"import": "./dist/capabilities/naming/index.js"
		},
		"./object-forwarding": "./dist/lib/object-forwarding.js",
		"./single-use": "./dist/lib/single-use.js",
		"./port": "./dist/lib/port.js",
		"./documentation": {
			"types": "./dist/capabilities/documentation/index.d.ts",
			"import": "./dist/capabilities/documentation/index.js"
		},
		"./formatting": {
			"types": "./dist/capabilities/formatting/index.d.ts",
			"import": "./dist/capabilities/formatting/index.js"
		},
		"./imports": {
			"types": "./dist/capabilities/imports/index.d.ts",
			"import": "./dist/capabilities/imports/index.js"
		},
		"./patterns": {
			"types": "./dist/capabilities/patterns/index.d.ts",
			"import": "./dist/capabilities/patterns/index.js"
		},
		"./security": {
			"types": "./dist/capabilities/security/index.d.ts",
			"import": "./dist/capabilities/security/index.js"
		},
		"./ui-quality": "./dist/lib/ui-quality.js",
		"./language-checks": "./dist/lib/language-checks.js",
		"./reports": {
			"types": "./dist/capabilities/reports/index.d.ts",
			"import": "./dist/capabilities/reports/index.js"
		},
		"./core": {
			"types": "./dist/capabilities/core/index.d.ts",
			"import": "./dist/capabilities/core/index.js"
		},
		"./ui": {
			"types": "./dist/capabilities/ui/index.d.ts",
			"import": "./dist/capabilities/ui/index.js"
		},
		"./languages": {
			"types": "./dist/capabilities/languages/index.d.ts",
			"import": "./dist/capabilities/languages/index.js"
		},
		"./refactoring": {
			"types": "./dist/capabilities/refactoring/index.d.ts",
			"import": "./dist/capabilities/refactoring/index.js"
		},
		"./reports/github": "./dist/capabilities/reports/lib/github-report.js",
		"./reports/history": "./dist/capabilities/reports/lib/history-report.js",
		"./reports/node-reporter": "./dist/capabilities/reports/lib/node-reporter.js",
		"./reports/playwright-reporter": "./dist/capabilities/reports/lib/playwright-reporter.js",
		"./reports/cli": {
			"types": "./dist/capabilities/reports/cli.d.ts",
			"import": "./dist/capabilities/reports/cli.js"
		},
		"./ui/cli": {
			"types": "./dist/capabilities/ui/cli.d.ts",
			"import": "./dist/capabilities/ui/cli.js"
		},
		"./languages/cli": {
			"types": "./dist/capabilities/languages/cli.d.ts",
			"import": "./dist/capabilities/languages/cli.js"
		},
		"./documentation/cli": {
			"types": "./dist/capabilities/documentation/cli.d.ts",
			"import": "./dist/capabilities/documentation/cli.js"
		},
		"./formatting/cli": {
			"types": "./dist/capabilities/formatting/cli.d.ts",
			"import": "./dist/capabilities/formatting/cli.js"
		},
		"./imports/cli": {
			"types": "./dist/capabilities/imports/cli.d.ts",
			"import": "./dist/capabilities/imports/cli.js"
		},
		"./naming/cli": {
			"types": "./dist/capabilities/naming/cli.d.ts",
			"import": "./dist/capabilities/naming/cli.js"
		},
		"./patterns/cli": {
			"types": "./dist/capabilities/patterns/cli.d.ts",
			"import": "./dist/capabilities/patterns/cli.js"
		},
		"./refactoring/cli": {
			"types": "./dist/capabilities/refactoring/cli.d.ts",
			"import": "./dist/capabilities/refactoring/cli.js"
		},
		"./security/cli": {
			"types": "./dist/capabilities/security/cli.d.ts",
			"import": "./dist/capabilities/security/cli.js"
		}
	},
	"files": [
		"dist",
		"quality.schema.json",
		"quality-configs"
	],
	"scripts": {
		"quality": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality",
		"quality:all": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality --all",
		"build": "tsc -p config/tsconfig.json",
		"test": "npm run build && mkdir -p tests/results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=tests/results/junit.xml",
		"prepare": "npm run build",
		"typecheck": "tsc --noEmit -p config/tsconfig.json"
	},
	"dependencies": {
		"typescript": "^5.0.0",
		"@terra-symposium/boundaries": "^0.2.0"
	},
	"peerDependencies": {
		"eslint": ">=9"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^26.6.5"
	}
}
