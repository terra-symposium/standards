{
	"name": "@terra-symposium/standards-quality",
	"version": "2.2.0",
	"description": "Configurable quality checks and maintenance tooling for software repositories",
	"homepage": "https://standards-docs.netlify.app/",
	"type": "module",
	"engines": {
		"node": ">=18.18"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"terra-quality": "dist/lib/runner.js",
		"terra-quality-dev": "dist/lib/dev.js"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Terra-Symposium/standards.git"
	},
	"exports": {
		".": "./dist/index.js",
		"./error-boundaries/react": "./dist/lib/error-boundaries-react.js",
		"./astro-integration": "./dist/lib/error-boundaries-astro.js",
		"./cli": "./dist/lib/runner.js",
		"./naming": "./dist/lib/naming.js",
		"./object-forwarding": "./dist/lib/object-forwarding.js",
		"./single-use": "./dist/lib/single-use.js",
		"./port": "./dist/lib/port.js",
		"./documentation": "./dist/lib/documentation.js",
		"./formatting": "./dist/lib/formatting.js",
		"./imports": "./dist/lib/imports.js",
		"./patterns": "./dist/lib/patterns.js",
		"./security": "./dist/lib/security.js",
		"./ui-quality": "./dist/lib/ui-quality.js",
		"./language-checks": "./dist/lib/language-checks.js",
		"./reports": "./dist/lib/reports.js"
	},
	"files": [
		"dist",
		"quality.schema.json",
		"quality-configs"
	],
	"scripts": {
		"build": "tsc -p config/tsconfig.json",
		"test": "npm run build && node --test",
		"prepare": "npm run build",
		"typecheck": "tsc --noEmit -p config/tsconfig.json"
	},
	"dependencies": {
		"@terra-symposium/standards-error-boundaries": "^0.1.2",
		"typescript": "^5.0.0",
		"@terra-symposium/standards-quality-core": "workspace:*",
		"@terra-symposium/standards-documentation": "workspace:*",
		"@terra-symposium/standards-formatting": "workspace:*",
		"@terra-symposium/standards-imports": "workspace:*",
		"@terra-symposium/standards-naming": "workspace:*",
		"@terra-symposium/standards-refactoring": "workspace:*",
		"@terra-symposium/standards-security": "workspace:*",
		"@terra-symposium/standards-ui-quality": "workspace:*",
		"@terra-symposium/standards-patterns": "workspace:*",
		"@terra-symposium/standards-language-checks": "workspace:*",
		"@terra-symposium/standards-quality-reports": "workspace:*"
	},
	"peerDependencies": {
		"eslint": ">=9"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^26.6.5"
	}
}
