{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Terra quality configuration",
	"type": "object",
	"additionalProperties": false,
	"required": ["sourceRoots", "extensions"],
	"properties": {
		"$schema": { "type": "string" },
		"root": { "type": "string" },
		"sourceRoots": { "type": "array", "items": { "type": "string" } },
		"includeRoots": { "type": "array", "items": { "type": "string" } },
		"skippedDirectories": { "type": "array", "items": { "type": "string" }, "description": "Directory names or repository-relative directory paths excluded from source discovery." },
		"skippedFiles": { "type": "array", "items": { "type": "string" }, "description": "Repository-relative files excluded from source discovery." },
		"singleUse": {
			"type": "object",
			"properties": {
				"skippedDirectories": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Directory names, repository-relative paths, or files excluded as single-use declaration candidates while remaining available as references."
				}
			},
			"additionalProperties": false
		},
		"extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\." } },
		"aliases": { "type": "object", "additionalProperties": { "type": "string" } },
		"frameworkEntryExports": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
		"externalPrefixes": { "type": "array", "items": { "type": "string" } },
		"renameExports": { "type": "boolean" },
		"protectedIdentifiers": { "type": "array", "items": { "type": "string" } },
		"enabledChecks": { "$ref": "#/$defs/checkToggles" },
		"autofix": { "$ref": "#/$defs/autofixToggles" },
		"documentation": {
			"type": "object",
			"properties": {
				"commandRoots": { "type": "array", "items": { "type": "string" }, "description": "Markdown roots where fenced pnpm commands are checked for deprecated directory flags." },
				"required": {
					"type": "object",
					"properties": {
						"types": { "type": "boolean" },
						"functions": {
							"type": "boolean",
							"default": true,
							"description": "Require documentation for every named function, method, and constructor in configured source roots, including parameter and return documentation where applicable. Defaults to true for every supported language."
						},
						"exportedFunctions": { "type": "boolean", "description": "Require TSDoc for exported named functions, including substantive descriptions for every parameter." },
						"noInlineFunctions": { "type": "boolean" }
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"tailwindCanonical": {
			"type": "object",
			"required": ["stylesheet"],
			"properties": {
				"stylesheet": { "type": "string" },
				"sourceRoots": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false
		},
		"security": {
			"type": "object",
			"properties": {
				"forbiddenTerms": { "type": "array", "items": { "type": "string" } },
				"forbiddenImports": { "type": "array", "items": { "type": "string" } },
				"clientRoots": { "type": "array", "items": { "type": "string" } },
				"allowProcessEnvRoots": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false
		},
		"repeatedClasses": {
			"type": "object",
			"properties": {
				"minimumCount": { "type": "number" },
				"extensions": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false
		},
		"regexDedup": {
			"type": "object",
			"properties": {
				"minimumCount": { "type": "number" },
				"extensions": { "type": "array", "items": { "type": "string" } },
				"sharedModule": { "type": "string", "minLength": 1 }
			},
			"additionalProperties": false
		},
		"uiPatterns": {
			"type": "object",
			"properties": {
				"forbidden": { "type": "array", "items": { "type": "string" } },
				"extensions": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false
		},
		"performancePatterns": {
			"type": "object",
			"properties": {
				"extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\." } },
				"ignoredFiles": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false,
			"description": "Opt-in advisory scan for repeated linear collection lookups inside collection callbacks."
		},
		"uiRecommendations": {
			"type": "object",
			"properties": {
				"rules": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["element", "component", "import"],
						"properties": {
							"element": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
							"component": { "type": "string", "minLength": 1 },
							"import": { "type": "string", "minLength": 1 },
							"variant": { "type": "string", "minLength": 1 },
							"types": { "type": "array", "items": { "type": "string" } },
							"when": { "enum": ["always", "button-like", "text-link"] },
							"reason": { "type": "string" }
						},
						"additionalProperties": false
					}
				},
				"extensions": { "type": "array", "items": { "enum": [".astro", ".jsx", ".tsx"] } },
				"ignoredFiles": { "type": "array", "items": { "type": "string" } },
				"ignoredDirectories": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false
		},
		"github": {
			"type": "object",
			"properties": {
				"repositories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" } },
				"requiredFeatures": {
					"type": "array",
					"uniqueItems": true,
					"items": { "enum": ["dependencyGraph", "dependabotAlerts", "malwareAlerts", "securityUpdates", "versionUpdates", "groupedUpdates", "secretScanning", "pushProtection", "codeScanning"] }
				}
			},
			"additionalProperties": false
		},
		"enabledCommands": { "type": "object", "additionalProperties": { "type": "boolean" } },
		"enabledRecommendations": { "type": "object", "additionalProperties": { "type": "boolean" } },
		"languageProfiles": {
			"type": "array",
			"uniqueItems": true,
			"items": { "enum": ["c", "java", "python"] },
			"description": "Optional native-language quality profiles. Documentation coverage is always discovered for supported languages with source files; selecting a profile enables its remaining native checks."
		},
		"qualityCommands": {
			"$ref": "#/$defs/commands",
			"description": "Commands selected for the quality run. Terra Quality owns phase order and test grouping; array order is preserved within ordinary phases and within each test group."
		},
		"recommendationCommands": { "$ref": "#/$defs/commands" },
		"tsconfig": { "type": "string" },
		"oneLineImports": { "type": "boolean" },
		"prettierPrintWidth": { "type": "number" },
		"lintRoots": { "type": "array", "items": { "type": "string" } },
		"typecheckRoots": { "type": "array", "items": { "type": "string" } },
		"typecheckExtensions": { "type": "array", "items": { "type": "string" } },
		"typecheckCommand": {
			"type": "object",
			"required": ["command"],
			"properties": {
				"command": { "type": "string" },
				"args": { "type": "array", "items": { "type": "string" } }
			},
			"additionalProperties": false
		},
		"loadTesting": {
			"type": "object",
			"properties": {
				"enabled": { "type": "boolean" },
				"defaultBudget": { "$ref": "#/$defs/loadBudget" },
				"testBudgets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/loadBudget" } },
				"operationBudgets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/loadBudget" } }
			},
			"additionalProperties": false
		},
		"tools": { "type": "object", "additionalProperties": { "type": "string" } }
	},
	"$defs": {
		"checkToggles": {
			"type": "object",
			"properties": {
				"accessibility": {
					"type": "boolean",
					"description": "Opt-in check for source-evident accessible names and decorative inline SVG exposure on native JSX controls and explicit interactive roles."
				},
				"display-name": { "type": "boolean", "description": "Opt-in check for direct React forwardRef declarations without displayName." },
				"performance-patterns": { "type": "boolean", "description": "Reports configured syntax patterns that may repeat work in collection callbacks; advisory only." },
				"documented-commands": { "type": "boolean", "description": "Checks deprecated pnpm directory flags in configured Markdown shell fences." }
			},
			"additionalProperties": { "type": "boolean" }
		},
		"autofixToggles": {
			"type": "object",
			"properties": {
				"accessibility": { "type": "boolean", "description": "Copies a literal title into aria-label or hides an unnamed inline SVG inside an already named control." },
				"displayName": { "type": "boolean", "description": "Adds a conventional displayName to a direct named forwardRef declaration." },
				"documentedCommands": { "type": "boolean", "description": "Rewrites pnpm -C and --prefix to the repository's canonical --dir flag in configured Markdown shell fences." }
			},
			"additionalProperties": { "type": "boolean" }
		},
		"loadBudget": {
			"type": "object",
			"properties": {
				"warnMs": { "type": "number", "minimum": 0 },
				"failMs": { "type": "number", "minimum": 0 }
			},
			"additionalProperties": false,
			"anyOf": [{ "required": ["warnMs"] }, { "required": ["failMs"] }]
		},
		"commands": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name", "command"],
				"properties": {
					"name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
					"command": { "type": "string" },
					"args": { "type": "array", "items": { "type": "string" } }
				},
				"additionalProperties": false
			}
		}
	}
}
