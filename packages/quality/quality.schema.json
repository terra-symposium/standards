{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra quality configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceRoots", "extensions"],
  "properties": {
    "$schema": { "type": "string" },
    "root": { "type": "string" },
    "sourceRoots": { "type": "array", "items": { "type": "string" } },
    "includeRoots": { "type": "array", "items": { "type": "string" } },
    "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\." } },
    "aliases": { "type": "object", "additionalProperties": { "type": "string" } },
    "externalPrefixes": { "type": "array", "items": { "type": "string" } },
    "skippedDirectories": { "type": "array", "items": { "type": "string" } },
    "skippedFiles": { "type": "array", "items": { "type": "string" } },
    "singleUse": {
      "type": "object",
      "properties": { "skippedDirectories": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "protectedIdentifiers": { "type": "array", "items": { "type": "string" } },
    "enabledChecks": { "$ref": "#/$defs/toggles" },
    "autofix": { "$ref": "#/$defs/toggles" },
    "documentation": {
      "type": "object",
      "properties": {
        "required": {
          "type": "object",
          "properties": {
            "types": { "type": "boolean" },
            "functions": { "type": "boolean" },
            "exportedFunctions": { "type": "boolean" },
            "noInlineFunctions": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tailwindCanonical": {
      "type": "object",
      "required": ["stylesheet"],
      "properties": {
        "stylesheet": { "type": "string" },
        "sourceRoots": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "forbiddenTerms": { "type": "array", "items": { "type": "string" } },
        "forbiddenImports": { "type": "array", "items": { "type": "string" } },
        "clientRoots": { "type": "array", "items": { "type": "string" } },
        "allowProcessEnvRoots": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "repeatedClasses": { "type": "object", "properties": { "minimumCount": { "type": "number" }, "extensions": { "type": "array", "items": { "type": "string" } }, "ignoredDirectories": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "regexDedup": { "type": "object", "properties": { "minimumCount": { "type": "number" }, "extensions": { "type": "array", "items": { "type": "string" } }, "ignoredFiles": { "type": "array", "items": { "type": "string" } }, "sharedModule": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "uiPatterns": { "type": "object", "properties": { "forbidden": { "type": "array", "items": { "type": "string" } }, "ignoredFiles": { "type": "array", "items": { "type": "string" } }, "extensions": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "enabledCommands": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "enabledRecommendations": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "qualityCommands": { "$ref": "#/$defs/commands" },
    "recommendationCommands": { "$ref": "#/$defs/commands" },
    "tsconfig": { "type": "string" },
    "oneLineImports": { "type": "boolean" },
    "prettierPrintWidth": { "type": "number" },
    "lintRoots": { "type": "array", "items": { "type": "string" } },
    "typecheckRoots": { "type": "array", "items": { "type": "string" } },
    "typecheckExtensions": { "type": "array", "items": { "type": "string" } },
    "typecheckCommand": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "tools": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "toggles": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
