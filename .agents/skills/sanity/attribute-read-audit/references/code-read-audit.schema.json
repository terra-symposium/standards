{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Sanity Attribute Code Read Audit",
	"type": "object",
	"additionalProperties": false,
	"required": ["dataset", "scannedAt", "sourceRevision", "complete", "reconciled", "paths"],
	"properties": {
		"dataset": { "type": "string", "minLength": 1 },
		"scannedAt": { "type": "string", "format": "date-time" },
		"sourceRevision": { "type": "string", "minLength": 1 },
		"complete": { "const": true },
		"reconciled": { "const": true },
		"paths": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "datatype", "documentTypes"],
				"properties": {
					"path": { "type": "string", "minLength": 1 },
					"datatype": { "enum": ["array", "boolean", "image", "null", "number", "object", "reference", "string"] },
					"documentTypes": {
						"type": "object",
						"minProperties": 1,
						"additionalProperties": {
							"type": "object",
							"additionalProperties": false,
							"required": ["classification", "evidence"],
							"properties": {
								"classification": { "enum": ["read", "maintenance-only", "uncertain", "no-read-found"] },
								"evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
								"operationalEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
							}
						}
					}
				}
			}
		}
	}
}
