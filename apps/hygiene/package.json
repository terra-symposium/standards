{
	"name": "@terra-symposium/hygiene-dashboard",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"quality": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality",
		"quality:all": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality --all",
		"dev": "node scripts/prepare-cache.mjs && terra-quality-dev -- astro --config config/astro.config.mjs --tsconfig config/tsconfig.json dev --host 127.0.0.1",
		"build": "node scripts/prepare-cache.mjs && pnpm --dir ../.. exec terra-quality error-boundaries --all && astro --config config/astro.config.mjs --tsconfig config/tsconfig.json build",
		"test": "mkdir -p tests/results && tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=tests/results/junit.xml tests/*.test.ts",
		"typecheck": "astro check --config config/astro.config.mjs --tsconfig config/tsconfig.json"
	},
	"dependencies": {
		"@astrojs/react": "^7.1.0",
		"@neondatabase/serverless": "^1.0.2",
		"@terra-symposium/standards-error-boundaries": "workspace:*",
		"astro": "^7.4.0",
		"fast-xml-parser": "^5.2.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@terra-symposium/standards-quality": "workspace:*",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3"
	}
}
