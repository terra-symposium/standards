{
	"$schema": "./packages/quality/quality.schema.json",
	"root": ".",
	"sourceRoots": ["packages", "scripts"],
	"extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"],
	"tools": { "eslint": "eslint", "knip": "knip", "prettier": "prettier" },
	"oneLineImports": true,
	"singleUse": { "skippedDirectories": ["packages/quality", "packages/reporting"] },
	"renameExports": true,
	"prettierPrintWidth": 200,
	"github": {
		"repositories": [
			"salesphere-vh/salesphere",
			"Terra-Symposium/terra-symposium-website",
			"Terra-Symposium/terra-shared",
			"kaimacann/personal-monorepo"
		],
		"requiredFeatures": ["dependencyGraph", "dependabotAlerts", "malwareAlerts", "securityUpdates", "versionUpdates", "groupedUpdates"],
		"featureExemptions": {
			"salesphere-vh/salesphere": ["dependencyGraph", "dependabotAlerts", "malwareAlerts", "securityUpdates", "versionUpdates", "groupedUpdates"]
		}
	},
	"qualityCommands": [
		{ "name": "build", "command": "pnpm", "args": ["run", "build"] },
		{ "name": "test", "command": "pnpm", "args": ["run", "test"] }
	],
	"documentation": {"required":{"types":true,"functions":true,"exportedFunctions":true,"noInlineFunctions":false}},
	"enabledChecks": {"format":true,"lint":true,"knip":true,"type":true,"recommend":true,"name":true,"alias":true}
}
