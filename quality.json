{
	"$schema": "./packages/quality/quality.schema.json",
	"root": ".",
	"sourceRoots": ["packages", "scripts"],
	"extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"],
	"tools": { "eslint": "eslint", "knip": "knip", "prettier": "prettier" },
	"oneLineImports": true,
	"frameworkEntryExports": {
		"packages/error-boundaries/src/astro.ts": ["ERROR_STATUS_COPY"],
		"packages/reporting/src/core.ts": ["normalizeVisualStatus"],
		"packages/reporting/src/viewports.ts": ["baseVisualProjectName", "viewportSizeLabel"],
		"packages/reporting/src/playwright.ts": ["diagnosticsTest", "stripAnsi", "parseDiagnostics"],
		"packages/reporting/src/spreadsheet.ts": ["writeSpreadsheet"],
		"packages/reporting/src/slideshow.ts": ["writeSlideshow"]
	},
	"singleUse": { "skippedDirectories": ["packages/quality"] },
	"renameExports": true,
	"prettierPrintWidth": 200,
	"qualityCommands": [
		{ "name": "build", "command": "pnpm", "args": ["run", "build"] },
		{ "name": "test", "command": "pnpm", "args": ["run", "test"] }
	]
}
