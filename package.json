{
	"name": "@terra-symposium/shared",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@10.30.3",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test",
		"prequality": "pnpm --filter @terra-symposium/quality build",
		"quality": "node scripts/quality/index.mjs",
		"prequality:all": "pnpm --filter @terra-symposium/quality build",
		"quality:all": "node scripts/quality/index.mjs quality --all",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.7",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.14.1",
		"eslint": "^10.9.1",
		"globals": "^17.12.0",
		"knip": "^6.34.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0"
	}
}
