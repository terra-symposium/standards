{
	"name": "@terra-symposium/standards",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@10.30.3",
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"pretest": "pnpm --filter './packages/**' -r build",
		"test": "node packages/quality/dist/workspace-test-runner.js",
		"prepare": "husky",
		"prequality": "pnpm --filter @terra-symposium/standards-quality build",
		"quality": "node packages/quality/dist/runner.js quality --skip-commands --skip-recommendations",
		"prequality:all": "pnpm --filter @terra-symposium/standards-quality build && pnpm --filter @terra-symposium/standards-error-boundaries build",
		"quality:all": "node packages/quality/dist/runner.js quality --all --skip-commands --skip-recommendations",
		"prequality:check": "pnpm --filter @terra-symposium/standards-quality build && pnpm --filter @terra-symposium/standards-error-boundaries build",
		"quality:check": "node packages/quality/dist/runner.js quality --all --warn --skip-commands --skip-recommendations",
		"prequality:github": "pnpm --filter @terra-symposium/standards-quality build",
		"quality:github": "node packages/quality/dist/runner.js github --report-json .quality-github-report.json",
		"docs:dev": "pnpm --filter @terra-symposium/docs dev",
		"docs:build": "pnpm --filter @terra-symposium/docs build",
		"docs:preview": "pnpm --filter @terra-symposium/docs preview",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.14.1",
		"eslint": "^10.9.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0"
	},
	"pnpm": {
		"overrides": {
			"braces": "workspace:*",
			"brace-expansion@5": "5.0.12",
			"http-cache-semantics": "4.3.0",
			"image-size": "2.0.4",
			"postcss-selector-parser": "7.1.6",
			"smol-toml": "1.9.1",
			"uuid": "11.1.1"
		}
	}
}
