{
  "name": "@terra-symposium/standards",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "docs": {
    "title": "Standards",
    "description": "Documentation for shared Terra Symposium packages and tools.",
    "site": "https://standards-docs.netlify.app",
    "out": "dist/docs"
  },
  "scripts": {
		"build": "pnpm --filter @terra-symposium/standards-quality build && pnpm --filter @terra-symposium/standards-error-boundaries build && node packages/quality/dist/lib/runner.js error-boundaries --all && pnpm -r build",
    "test": "pnpm --filter './packages/**' -r build && node packages/testing/src/cli.mjs run --manifest tests/terra-tests.json",
    "quality": "pnpm --filter @terra-symposium/standards-quality build && node scripts/quality.mjs quality --skip-commands --skip-recommendations",
    "docs": "docs dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@terra-symposium/docs": "^0.4.3",
    "@types/node": "^26.6.5",
    "astro": "7.4.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.12",
      "http-cache-semantics": "4.3.0",
      "image-size": "2.0.4",
      "postcss-selector-parser": "7.1.6",
      "smol-toml": "1.9.1",
      "uuid": "11.1.1"
    }
  }
}
