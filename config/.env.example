# Set DATABASE_URL directly or use the connected Netlify Neon integration.
# Netlify's Neon integration exposes NETLIFY_DATABASE_URL at runtime.
DATABASE_URL=
# Local Netlify Dev URL. Add http://127.0.0.1/api/callback as a GitHub App callback URL.
APP_ORIGIN=http://127.0.0.1:8888
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
SESSION_SECRET=
PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app/installations/new
