{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/quality.mjs"],
			"project": ["scripts/**/*.mjs"]
		},
		"config": {
			"entry": ["scripts/build-docs.mjs", "scripts/typecheck.mjs"],
			"project": ["scripts/**/*.mjs"]
		},
		"packages/braces": {
			"entry": ["index.js", "test/**/*.test.mjs"],
			"project": ["lib/**/*.js", "test/**/*.mjs"]
		},
		"packages/error-boundaries": {
			"entry": ["src/index.ts", "src/components/react.tsx", "src/lib/astro.ts", "src/lib/astro-integration.ts", "src/lib/next.ts", "test/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"],
			"ignoreDependencies": ["@types/react-dom", "react-dom"]
		},
		"packages/reporting": {
			"entry": ["src/index.ts", "src/lib/core.ts", "src/lib/playwright.ts", "src/lib/viewports.ts", "src/lib/load-testing.ts", "src/lib/spreadsheet.ts", "src/lib/slideshow.ts", "test/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"],
			"ignoreDependencies": ["@oai/artifact-tool", "colorjs.io"]
		},
		"packages/testing": {
			"entry": ["src/index.mjs", "src/cli.mjs"],
			"project": ["src/**/*.mjs"]
		},
		"packages/quality": {
			"entry": [
				"src/index.ts",
				"src/lib/runner.ts",
				"src/lib/dev.ts",
				"src/app/workspace-test-runner.ts",
				"src/lib/error-boundaries-astro.ts",
				"src/lib/error-boundaries-react.ts",
				"src/lib/documentation.ts",
				"src/lib/formatting.ts",
				"src/lib/imports.ts",
				"src/lib/language-checks.ts",
				"src/lib/naming.ts",
				"src/lib/object-forwarding.ts",
				"src/lib/patterns.ts",
				"src/lib/reports.ts",
				"src/lib/security.ts",
				"src/lib/single-use.ts",
				"src/lib/port.ts",
				"src/lib/ui-quality.ts",
				"test/**/*.test.mjs"
			],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"docs": {
			"entry": ["src/pages/**/*.astro", "astro.config.mjs", "scripts/*.mjs", "agents/**/scripts/*.mjs"],
			"project": ["src/**/*.astro", "src/**/*.tsx", "src/**/*.ts", "src/**/*.mdx", "scripts/**/*.mjs", "agents/**/scripts/**/*.mjs"],
			"ignoreDependencies": ["@terra-symposium/styling"]
		},
		"apps/hygiene": {
			"entry": ["src/pages/index.astro", "config/**/*.mjs", "netlify/functions/*.mts", "scripts/*.ts", "test/*.test.ts"],
			"project": ["src/**/*.ts", "src/**/*.tsx", "config/**/*.mjs", "netlify/functions/**/*.mts", "scripts/**/*.ts", "test/**/*.ts"]
		},
		"packages/quality-core": {
			"entry": ["src/index.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/documentation": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/formatting": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/imports": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/naming": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/refactoring": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/security": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/ui-quality": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/patterns": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/language-checks": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		},
		"packages/quality-reports": {
			"entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.mjs"],
			"project": ["src/**/*.ts", "test/**/*.mjs"]
		}
	},
	"ignoreDependencies": ["pptxgenjs", "prettier"],
	"ignoreBinaries": ["codex"],
	"ignoreFiles": ["packages/*/dist/**"],
	"ignoreIssues": {
		"vendor/braces/lib/utils.js": ["exports"]
	}
}
